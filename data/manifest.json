{
  "tables": [
    {
      "file": "sessions.csv",
      "columns": [
        "session_id",
        "course_version",
        "topic",
        "start_date",
        "end_date"
      ],
      "key": "session_id"
    },
    {
      "file": "attendance.csv",
      "columns": [
        "person_token",
        "household_token",
        "session_id",
        "stage",
        "status"
      ]
    },
    {
      "file": "responses.csv",
      "columns": [
        "response_id",
        "person_token",
        "session_id",
        "phase",
        "form_version",
        "item_id",
        "answer",
        "submitted_at"
      ],
      "key": "response_id"
    },
    {
      "file": "measurements.csv",
      "columns": [
        "form_version",
        "item_id",
        "topic",
        "valid_from",
        "valid_to"
      ]
    },
    {
      "file": "answer_keys.csv",
      "optional": true,
      "columns": [
        "form_version",
        "item_id",
        "correct_answer",
        "key_version",
        "valid_from",
        "valid_to"
      ]
    },
    {
      "file": "observations.csv",
      "optional": true,
      "columns": [
        "observation_id",
        "person_token",
        "household_token",
        "session_id",
        "stage",
        "result",
        "note"
      ],
      "key": "observation_id"
    },
    {
      "file": "feedback.csv",
      "optional": true,
      "columns": [
        "feedback_id",
        "household_token",
        "session_id",
        "submitted_by",
        "rating",
        "confidence",
        "submitted_at"
      ],
      "key": "feedback_id"
    }
  ]
}
